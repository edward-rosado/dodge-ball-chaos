{
  "name": "dodge-ball-chaos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:quick": "vitest run --exclude='**/beatability*'",
    "test:coverage": "vitest run --exclude='**/beatability*' --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf .next out node_modules",
    "setup": "npm install && npm run build",
    "test:beatability": "tsx scripts/test-beatability.ts",
    "prepare": "git config core.hooksPath .githooks",
    "git:log": "git log --oneline main..HEAD",
    "git:diff": "git diff --stat main..HEAD",
    "git:status": "git status"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
